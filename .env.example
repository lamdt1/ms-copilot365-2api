# Server config
HOST=0.0.0.0
PORT=8000
API_KEY=sk-m365-copilot-secret-key
LOG_LEVEL=INFO
RATE_LIMIT_RPM=60
MAX_CONCURRENT_WS=5

# Docker / Virtual display
DISPLAY=:99
NOVNC_ENABLE=true
VNC_PASSWORD=

# Camoufox config
CAMOUFOX_HEADLESS=false
CAMOUFOX_AUTO_HEADLESS=true
CAMOUFOX_USER_DATA_DIR=/app/data/camoufox_profile

# Token config
TOKEN_PREFETCH_MARGIN=600
LOG_TOKEN_CLAIMS=false

# Engine selection
TOOL_CALLING_ENGINE=auto
